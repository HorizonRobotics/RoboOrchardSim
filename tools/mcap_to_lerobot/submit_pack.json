  "cmd": [
    "ulimit -n 65536",
    "pip install --no-deps lerobot==0.3.3",
    "pip install --no-deps jsonlines==4.0.0",
    "pip install --no-deps av",
    "export PYTHONPATH=${WORKING_PATH}:$PYTHONPATH",
    "echo $PYTHONPATH",
    "manifest_path=**{path/to/your/manifest.json}**",
    "output_path=/horizon-bucket/robot_lab/users/ziang.li/sim_data/anymove/datasets/lerobot_0617_piper/pick_category_test",
    "embodiment=dualarm_piperx",
    "repo_id=robo_orchard/piperx_pack",
    "cd ${WORKING_PATH} && \\",
    "python3 -m tools.mcap_to_lerobot.convert \\",
    "    --embodiment ${embodiment} \\",
    "    --manifest ${manifest_path} \\",
    "    --out /job_data/lerobot_local \\",
    "    --repo-id ${repo_id} \\",
    "    --num-workers 4 \\",
    "    --upload-to ${output_path} \\",
    "    --best-effort"
  ],
  "to_upload": [
    "robo_orchard_sim",
    "tools",
    "manifest.json"
  ],
