{
  "job_name": "lerobot_pack_test",
  "workspace_folder": "submit-pack",
  "docker_image": "hub.hobot.cc/auto/robot_lab/mengao.zhao:ubuntu22.04-gcc11.4-py3.11-cuda12.8-isaac_lab-v2.0.2-sem-ext-v0.2",
  "input_bucket": "robot_lab,robot_lab2",
